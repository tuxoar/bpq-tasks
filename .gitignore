# Audit logs - contain node hostnames and activity history
*.log

# Exported messages - contain real traffic (names, addresses, phone numbers)
stale-*/
exports/

# Node backups - contain node passwords, bpq.env, VARA license, real mail
backups/

# Local credential files (sourced env files hold the node password)
*.env
*.env.ps1
*.env.bat

# Python
__pycache__/
*.pyc
.venv/
venv/
