# bpq-tasks sample environment file.
#
# Copy it, fill in your values, lock it down, then source it per session:
#
#     cp bpq.env.sample bpq.env
#     chmod 600 bpq.env
#     source bpq.env
#
# bpq.env is gitignored (*.env), so real credentials cannot be committed.
# PowerShell users: create bpq.env.ps1 with $env:NAME = 'value' lines
# instead and dot-source it (see README).

# --- Node connection (bpq_admin.py, all actions) -------------------------
export BPQ_HOST=mynode.example.com
export BPQ_PORT=8010
export BPQ_USER=N0CALL
export BPQ_PASSWORD=changeme

# --- QRZ.com lookups (extract_emails.py) ---------------------------------
# Requires a QRZ XML Logbook Data subscription. Leave commented to run
# with --no-qrz instead.
#export QRZ_USER=N0CALL
#export QRZ_PASSWORD=changeme

# --- Proton Mail Bridge delivery (deliver_emails.py) ---------------------
# Creates the emails.txt messages in your mailbox as drafts (or sends
# them). Bridge must be running; USER is your Proton address and PASSWORD
# the password Bridge generates - not your Proton password. Everything
# else defaults to Bridge's settings (127.0.0.1, IMAP 1143, SMTP 1025,
# STARTTLS). Setup and the full variable list: docs/deliver-emails.md.
#export BPQ_DELIVER_USER=you@proton.me
#export BPQ_DELIVER_PASSWORD=bridge-generated-password
#export BPQ_DELIVER_FROM='Your Name N0CALL <you@proton.me>'   # default: USER
#export BPQ_DELIVER_IMAP_HOST=127.0.0.1
#export BPQ_DELIVER_IMAP_PORT=1143
#export BPQ_DELIVER_SMTP_HOST=127.0.0.1
#export BPQ_DELIVER_SMTP_PORT=1025
#export BPQ_DELIVER_SECURITY=starttls     # starttls | ssl | none (loopback only)
#export BPQ_DELIVER_CA_CERT=              # PEM to verify against; unset = trust loopback
#export BPQ_DELIVER_DRAFTS=               # Drafts folder; unset = discovered
# Gmail instead: IMAP_HOST=imap.gmail.com IMAP_PORT=993 SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465 SECURITY=ssl, with an app password.

# --- notify-stale channels -----------------------------------------------
# Every fully-configured channel receives the notice. Leave a channel's
# lines commented to disable it; configuring one only partially is an
# error, not a silent skip. Setup walkthroughs for all three are in
# docs/stale-notifier-spec.md section 5.

# Discord: channel settings -> Integrations -> Webhooks -> New Webhook,
# then copy the webhook URL. The URL is the credential - guard it.
#export BPQ_NOTIFY_DISCORD_WEBHOOK=https://discord.com/api/webhooks/1234567890/AbCdEf...

# Telegram: token from @BotFather /newbot; chat id from getUpdates after
# messaging your bot (group ids are negative - keep the minus sign).
#export BPQ_NOTIFY_TELEGRAM_TOKEN=123456789:AAF...
#export BPQ_NOTIFY_TELEGRAM_CHAT=123456789

# Email via an SMTP relay. HOST/FROM/TO are required; USER/PASSWORD only
# for an authenticated relay (STARTTLS is then required - an
# unauthenticated local relay like postfix on localhost:25 works without
# it). PORT defaults to 587.
#export BPQ_SMTP_HOST=smtp.gmail.com
#export BPQ_SMTP_PORT=587
#export BPQ_SMTP_USER=you@gmail.com
#export BPQ_SMTP_PASSWORD='abcd efgh ijkl mnop'   # Gmail app password
#export BPQ_SMTP_FROM=you@gmail.com
#export BPQ_SMTP_TO=sysop@example.com
